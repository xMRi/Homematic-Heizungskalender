#!/bin/sh
# Installationsskript für das Heizkalender-Addon
# Basiert auf https://github.com/homematic-community/ccu-addon-howto/blob/master/templates/update_script

ADDON=heizkalender
ADDONS_DIR=/usr/local/addons
ADDON_DIR=$ADDONS_DIR/$ADDON
CONF_DIR=/usr/local/etc/config
WWW_DIR=$CONF_DIR/addons/www/$ADDON
EXITCODE=10

mount | grep /usr/local 2>&1 >/dev/null
if [ $? -eq 1 ]; then
    mount /usr/local
fi

mkdir -p $ADDONS_DIR && chmod 755 $ADDONS_DIR
mkdir -p $CONF_DIR/addons/www && chmod 755 $CONF_DIR/addons/www
mkdir -p $CONF_DIR/rc.d

# Update-Erkennung: rc.d-Skript vorhanden = Update
if [ -f $CONF_DIR/rc.d/$ADDON ]; then
    EXITCODE=0
    $CONF_DIR/rc.d/$ADDON stop 2>/dev/null || true
fi

# Addon-Dateien kopieren (www/ komplett ersetzen, damit keine veralteten Dateien bleiben)
mkdir -p $ADDON_DIR
rm -rf $ADDON_DIR/www
cp VERSION $ADDON_DIR/VERSION
cp -r heizkalender/www $ADDON_DIR/www

# rc.d-Skript installieren
cp rc.d/$ADDON $CONF_DIR/rc.d/$ADDON
chmod 755 $CONF_DIR/rc.d/$ADDON

# WWW-Symlink anlegen (-n ersetzt auch einen existierenden Verzeichnis-Symlink)
rmdir $WWW_DIR 2>/dev/null
ln -sfn $ADDON_DIR/www $WWW_DIR

sync

exit $EXITCODE
