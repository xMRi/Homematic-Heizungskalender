STRINGTABLE
BEGIN
    IDS_ABOUTBOX            "&Informationen zu HeizkalenderInstallation..."
    IDS_TITLE               "Homematic Heizkalender Installations Assistent"
    IDP_SOCKETS_INIT_FAILED "Fehler beim Initialisieren der Windows-Sockets."
    IDS_PAGE_CONNECT        "Verbindung zur CCU"
    IDS_PAGE_SETTINGS       "Einstellungen"
    IDP_NEED_CONNECTION     "Um weitere Einstellungen sehen oder Ändern zu können muss zuerst eine Verbindung aufgebaut werden!"
    IDS_PAGE_SYSVAR         "Systemvariablen"
    IDS_PAGE_PROGRAMS       "Programme"
    IDS_PAGE_ROOMS          "Räume"
    IDS_MODE_CHURCHTOOLS    "ChurchTools-API"
    IDS_MODE_CHURCHDESK_ICAL "ChurchDesk-iCal"
END

STRINGTABLE
BEGIN
    IDS_MODE_CHURCHDESK_API "ChurchDesk-API"
    IDP_FILES_MISSING       "Eine oder mehrere Dateien für die Installation fehlen für die Installation. Das Programm wird kann nicht ausgeführt werden und wird beendet!\n\t%1"
    IDS_UNVERAENDERT        "Unverändert"
    IDP_NEWER_PROGRAMS      "Die aktuelle Installation enthält neuere Programme als dieses Installationspaket:\n\t%1\nEs werden keine Skripte installiert, da es zu einem Downgrade kommen würde.\nSollten Sie dennoch diese Version installieren wollen löschen Sie manuell diese Programme in der CCU."
    IDP_CHOOSE_MODE_MANUAL  "Aus den vorliegenden Daten und Programmen kann nicht ermittelt werden, auf welche Art (ChurchDesk, ChurchTools etc.) die Termine ermittelt werden sollen. Wählen Sie bitte den entsprechenden Modus manuell aus!"
    IDP_CHOOSE_NEW_MODE     "Dies ist eine neue Installation!\nWählen Sie bitte den entsprechenden Modus aus, mit dem die Heiztermine ermittelt werden sollen."
    IDP_CCU_UPDATE_SUCCESSFUL 
                            "Die CCU konnte erfolgreich aktualisiert werden!"
    IDP_CCU_UPDATE_FAILED   "Das CCU Update ist fehlgeschlagen!\n\t%1"
    IDP_CCU_NO_UPDATE       "Es sind keine Änderungen an der CCU Erforderlich!"
    IDP_QUERY_UPDATE_SIMUATION 
                            "Sollen die Änderungen der Smulation gespeichert werden?"
    IDS_TITLE_PROGRAMS      "Name;Datum akt.; Datum neu;Info"
    IDS_INST_NEW            "Programm wird neu installiert"
    IDS_INST_REPLACED       "Programm wird gelöscht und neu angelegt"
    IDS_INST_UPDATED        "Programm wird aktualisiert"
    IDS_INST_NOACTION       "Keine Aktion notwendig"
    IDP_KURVEN_WERTE_AUFSTEIGEND 
                            "Die Werte der Heizkurve in Minuten müssen jeweils größere Verzögerungen für kältere Temperaturen enthalten!"
END

STRINGTABLE
BEGIN
    AFX_IDS_APP_TITLE       "Heizkalender Installation"
END

STRINGTABLE
BEGIN
    IDP_NO_ROOMS            "Es wurden bisher keine Ressourcen/Raumdaten eingelesen oder definiert. Aktualisieren Sie die Raumliste für die Verbindung!"
    IDP_LOGIN_DATA_REQUIERED 
                            "Es werden Zugangsdaten benötigt um die Ressourcen einlesen zu können!"
    IDP_QUERY_MODE_SWITCH_WARNING 
                            "Sie haben bereits Zugangsdaten für den aktuellen Modus eingetragen. Diese gehen verloren, wenn Sie einen neue Terminquelle wählen!\nWollen Sie dennoch fortfahren?"
    IDP_QUERY_MODE_SWITCH_WARNING_RES 
                            "Es wurden bereits Raumdaten eingelesen und eine Raumliste angelegt. Wenn Sie die Quelle für die Termindaten ändern, wird die aktuelle Raumliste gelöscht. Die Variablen für die einzelnen Räume bleiben erhalten und können wiederverwendet werden. Aber alle Räume müssen neu zugeordnet.\nWollen Sie dennoch fortfahren?"
    IDP_TEST_AKTOR_SCHALTEN "Test für Kanal ""%1""\nSchaltzustand:\t%2"
    IDP_NEED_MODE           "Um weitere Einstellungen sehen und Ändern zu können muss die Art festegelgt werden, wie Heiztermine eingelesen werden!"
    IDP_FILE_INVALID        "Eine der Programmdateien im Anwednungsverzeichnis hat ein falsches bzw. unerwartetes Format!\n\t%1"
    IDP_QUERY_DATA_MODIFIED "Es wurden bereits Daten für die Installations erfasst, eventuelle Änderungen würden veroren gehen!\nEs wurden bisher keine Änderungen an der CCU Installation vorgenommen!\nWollen Sie das Programm dennoch beenden?"
    IDP_QUERY_RAUMLISTEN_NICHT_LEER 
                            "Die Raumlisten sind bereits gefüllt. Diese Werte und Zuordnungen bleiben erhalten. Ungültige Zuordnungen werden entfernt. Neue Räume oder Zuordnungen werden angelegt.\nWollen Sie fortfahren?"
    IDP_LESEN_VON_CHURCHTOOLS_FEHLGESCHLAGEN 
                            "Das Einlesen der Daten aus ChurchTools ist fehlgeschlagen! Kontrollieren Sie die Zugangsdaten!\n%1"
    IDS_TITLE_SYSVARS       "Name;Inhalt;Info"
    IDS_NEW                 "Neu"
    IDS_UPDATE              "Geändert"
    IDS_TITLE_ROOMS         "Name;S/V/H/HS;Temp.;Grund.;Faktor;Einsch.;Aussch.;Heizgr.;Info"
    IDS_SIMULATION          "Simulation"
    IDP_SIMULATION_GESTARTET 
                            "Sie haben die Heizkalender-Installation im Simulationsmodus gestartet.\nEs wird keine Verbindung zu einer CCU benötigt. Die Änderungen werden lokal in der Registry gespeichert und können später wieder geladen und bearbeitet werden."
END

STRINGTABLE
BEGIN
    IDP_QUERY_SIMULATION_LADEN 
                            "Wollen Sie die eine bestehende Simulation aus der Registry laden?\nWenn Sie mit Nein antworten, werden sie bisherigen Simulationsdaten verworfen und eine neue Simulation, mit einer leeren Konfiguration wird gestartet!"
    IDP_QUERY_UPDATE_CCU    "Sollen die Änderungen jetzt an die CCU übertragen werden?\nAchtung! Dieser Vorgang kann nur durch das Einspielen eines aktuellen Backups rückgängig gemacht werden!"
    IDP_RAUMVAR_NAMEN_KORREKTUR 
                            "Eine oder mehrere Raumvariablen stimmen nicht mit der Namenskovention für den Heizkalender überein. Die folgenden Raumvariablen, werden kopiert und neu angelegt:\n\t%1"
    IDS_TITLE_RESOURCES     "Id;Name;Zugeordnete Räume"
    IDS_PAGE_RESOURCES      "Kalenderzuordnungen"
    IDS_RAUM_MODUS          "Heizen;H\tSchalten;S\tHeizen+Schalten;HS\tVariable setzen;V"
    IDS_RAUM_DEVTYP         "IP - Homematic IP;RT- Klassik-Thermostate-Gerätetyp;TC - Klassik-Thermostate-Gerätetyp;IT - Klassik-Thermostate-Gerätetyp;SW - Sonstige"
    IDS_NEW_ROOM            "NeuerRaum"
    IDP_QUERY_DELETE_ROOM   "Soll der selektierte Raum ""%1"" gelöscht werden? Damit werden alle Kalenderzuordnungen für diesen Raum entfernt!\nWollen Sie fortfahren?"
    IDP_RAUM_NAME_EXISTIERT "Ein Raum mit dem Namen ""%1"" existiert bereits!"
    IDP_RAUM_NAME_FEHLT     "Es muss ein Raumname angegeben werden!"
    IDP_RAUMVAR_NAMEN_FEHLEN 
                            "Eine oder mehrere Raumvariablen fehlen. Die folgenden Raumvariablen, werden neu angelegt:\n\t%1"
    IDP_TEST_AKTOR_HEIZEN   "Test für Kanal ""%1""\nAktuelle Zieltemperatur:\t%2\nAktuelle Raumtemperatur:\t%3"
    IDP_RAUMLISTE_WURDE_AKTUALISIERT 
                            "Die Liste der Räume bzw. Ressourcen wurde aktualisiert.\nKontrollieren Sie evtl. neue vorhandene Raumvariablen!"
    IDP_RAUMLISTE_WURDE_NICHT_AKTUALISIERT 
                            "Die Liste der Räume bzw. Ressourcen wurde nicht verändert."
    IDS_AN_AUS              "AUS;AN"
END

